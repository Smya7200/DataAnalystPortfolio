--View data
SELECT *
FROM walmart_sales_raw
LIMIT 10;

--Count rows
SELECT COUNT(*) AS total_rows
FROM walmart_sales_raw;

--Check for duplicates
SELECT
	store,
	date,
	COUNT(*)
FROM walmart_sales_raw
GROUP BY store, date
HAVING COUNT(*) > 1; -- where a value is more than 1

--Summary Statistics (weekly sales)
SELECT
	ROUND(MIN(weekly_sales), 2),
	ROUND(MAX(weekly_sales), 2),
	ROUND(AVG(weekly_sales), 2)
FROM walmart_sales_raw;

-- Average Sales By Store
SELECT
	store,
	ROUND(AVG(weekly_sales), 2) AS avg_sales
FROM walmart_sales_raw
GROUP BY store
ORDER BY avg_sales DESC;
-- Which store units perform best in average weekly sales: 20, 4, 14 (top 3)

-- Which units had high unemployment and what were the avg sales?
SELECT
	store,
	MAX(unemployment) AS high_unemployment,
	ROUND(AVG(weekly_sales), 2) AS avg_sales
	FROM walmart_sales_raw
	GROUP BY store
	ORDER BY MAX(unemployment) DESC;

-- top average sales by holidays
SELECT
	store,
	holiday_flag,
	ROUND(AVG(weekly_sales), 2) AS avg_sales
FROM walmart_sales_raw
WHERE holiday_flag = 1
GROUP BY store, holiday_flag
ORDER BY avg_sales DESC;

-- top average sales non holidays
SELECT
	store,
	holiday_flag,
	ROUND(AVG(weekly_sales), 2) AS avg_sales
FROM walmart_sales_raw
WHERE holiday_flag = 0
GROUP BY store, holiday_flag
ORDER BY avg_sales DESC;
